% 根据中文学院名自动查询英文译名；未命中时返回空
\cs_new_protected:Npn \__hainanu_lookup_school_en:nN #1#2
  {
    \prop_get:NnNTF \g__hainanu_school_en_prop { #1 } \l_tmpa_tl
      { \tl_set_eq:NN #2 \l_tmpa_tl }
      { \tl_clear:N #2 }
  }
