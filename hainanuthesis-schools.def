    {化学工程与技术学院} = {School~of~Chemical~Engineering~and~Technology},
    {生物医学工程学院} = {School~of~Biomedical~Engineering},
    {食品科学与工程学院} = {School~of~Food~Science~and~Engineering},
    {热带作物学院} = {School~of~Tropical~Crops},
    {园艺学院} = {School~of~Horticulture},
    {农业农村学院（乡村振兴学院）} = {School~of~Agriculture~and~Rural~Affairs~(School~of~Rural~Revitalization)},
